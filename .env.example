SEO_CONTENT_ENABLED=false
SEO_CONTENT_AUTOPUBLISH=false
SEO_CONTENT_KILL_SWITCH=true
SEO_CONTENT_QUOTA_SP=5
SEO_CONTENT_QUOTA_ES=5
SEO_CONTENT_MAX_COST_MICROS=1000000
# All credentials below are server-only. No NEXT_PUBLIC/VITE prefix.
SEO_CONTENT_CRON_SECRET=
SEO_CONTENT_PREVIEW_SECRET=
SEO_CONTENT_SUPABASE_URL=
SEO_CONTENT_SUPABASE_SERVICE_KEY=
# Read-only, approved evidence gateway; see docs/seo-content-engine.md.
SEO_CONTENT_EVIDENCE_URL=
SEO_CONTENT_EVIDENCE_TOKEN=
SEO_CONTENT_EDITORIAL_URL=
SEO_CONTENT_EDITORIAL_TOKEN=
# Optional read-only short-lived OAuth token; refresh must be supplied by existing credential owner.
SEO_CONTENT_GSC_ACCESS_TOKEN=
SEO_CONTENT_GSC_SITE=https://www.yincorp.com.br/
# Set only from a passing CI release; must match VERCEL_GIT_COMMIT_SHA.
SEO_CONTENT_VERIFIED_RELEASE_SHA=
# Vercel uses this header secret for Cron; may equal SEO_CONTENT_CRON_SECRET.
CRON_SECRET=
# Optional direct editorial adapter. Reuse only an existing key in its owner environment;
# never copy/decrypt a secret from another project. No default paid model is selected.
SEO_CONTENT_RESEARCH_MODEL=
SEO_CONTENT_WRITE_MODEL=
SEO_CONTENT_AUDIT_MODEL=
# JSON object: each stage has input/output USD per million tokens (numerically micros/token).
SEO_CONTENT_MODEL_RATES=
SEO_CONTENT_ALLOW_RELATED_QUERY_HYPOTHESES=false
# Isolated inference is blocked unless both explicit authorization and budget exist.
SEO_CONTENT_INFERENCE_AUTHORIZED=false
SEO_CONTENT_APPROVED_BUDGET_MICROS=
# OPENAI_API_KEY must be provisioned directly in the isolated secret store if using
# the local bridge. Never put its value in this file or copy it from another project.
